version: 2

project_name: "<%= it.projectName %>"

builds:
  - id: "<%= it.projectName %>"
    main: .
    binary: "<%= it.commandName %>"
    env:
      - CGO_ENABLED=0
      - GOFLAGS=-mod=readonly
    flags:
      - -buildvcs=false
      - -trimpath
    mod_timestamp: "0"
    goos:
      - darwin
      - linux
    goarch:
      - amd64
      - arm64
    ldflags:
      - -s -w -X main.version={{ .Version }}

archives:
  - id: "<%= it.projectName %>"
    ids:
      - "<%= it.projectName %>"
    formats:
      - tar.gz
    name_template: "{{ .ProjectName }}_{{ .Version }}_{{ .Os }}_{{ .Arch }}"
    builds_info:
      owner: root
      group: root
      mtime: "1970-01-01T00:00:00Z"
    files:
      - src: README.md
        info: &archive_file_info
          owner: root
          group: root
          mode: 0644
          mtime: "1970-01-01T00:00:00Z"
      - src: LICENSE
        info: *archive_file_info

checksum:
  name_template: checksums.txt

snapshot:
  version_template: "{{ incpatch .Version }}-next"

changelog:
  disable: true
